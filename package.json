{
  "name": "instar",
  "version": "0.1.0",
  "private": true,
  "description": "Agent skills that learn from their own failures — agentic memory on CockroachDB + AWS",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/ingest/run.ts",
    "ingest:dry": "tsx src/ingest/run.ts --dry-run",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.677.0",
    "@smithy/fetch-http-handler": "^5.7.0",
    "next": "^15.5.23",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.121.0"
  }
}
